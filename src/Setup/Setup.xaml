<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wakelight Setup" Width="780" Height="480" ResizeMode="NoResize"
        Background="{StaticResource Night}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= art panel ================= -->
    <Grid Grid.Column="0" ClipToBounds="True">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
          <GradientStop Color="#241D45" Offset="0"/>
          <GradientStop Color="#120F24" Offset="0.6"/>
          <GradientStop Color="#0B0A14" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>
      <Canvas x:Name="Stars" IsHitTestVisible="False"/>
      <Ellipse x:Name="Halo" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40" Opacity="0.55">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#99FF8A6A" Offset="0"/>
            <GradientStop Color="#33FF5C8A" Offset="0.45"/>
            <GradientStop Color="#00FF5C8A" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Image x:Name="BigLogo" Width="132" Height="132" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40"
             RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,30">
        <TextBlock Text="Wakelight" FontFamily="{StaticResource Display}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
        <TextBlock Text="Your live wallpaper, awake while you're away." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
      </StackPanel>
    </Grid>

    <!-- ================= content ================= -->
    <Grid Grid.Column="1">
      <Button x:Name="CloseButton" Style="{StaticResource Caption}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
              WindowChrome.IsHitTestVisibleInChrome="True"/>

      <!-- Welcome -->
      <Grid x:Name="PageWelcome" Margin="40,56,40,32">
        <StackPanel>
          <TextBlock x:Name="WelcomeEyebrow" Style="{StaticResource Eyebrow}" Text="SETUP · VERSION 1.1"/>
          <TextBlock x:Name="WelcomeTitle" Style="{StaticResource H1}" FontSize="30" Margin="0,10,0,0" TextWrapping="Wrap"
                     Text="Let your wallpaper keep the lights on."/>
          <TextBlock x:Name="WelcomeBody" Style="{StaticResource Body}" Foreground="{StaticResource Sub}" Margin="0,14,0,0" LineHeight="21"
                     Text="When you step away, Wakelight plays your Wallpaper Engine scene full screen with a clock, keeps your lock screen matched to it, and locks the PC when you come back."/>
          <StackPanel Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Ellipse Width="6" Height="6" Fill="{StaticResource Ember}" VerticalAlignment="Center"/>
              <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" Text="Live showcase after you go idle"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Ellipse Width="6" Height="6" Fill="#FF8873" VerticalAlignment="Center"/>
              <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" Text="Lock screen that matches your wallpaper"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{StaticResource Rose}" VerticalAlignment="Center"/>
              <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" Text="Locks when you return, on your schedule"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <Grid VerticalAlignment="Bottom">
          <Button x:Name="CustomizeButton" Style="{StaticResource Link}" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Customize installation"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="UninstallButton" Style="{StaticResource Ghost}" Content="Uninstall" Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button x:Name="InstallButton" Style="{StaticResource Primary}" Padding="30,11" Content="Install"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- Options -->
      <Grid x:Name="PageOptions" Margin="40,56,40,32" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Style="{StaticResource Eyebrow}" Text="CUSTOMIZE"/>
          <TextBlock Style="{StaticResource H1}" Margin="0,10,0,0" Text="Make it yours"/>
          <TextBlock Style="{StaticResource Body}" Margin="0,22,0,6" Text="Install location"/>
          <Border CornerRadius="10" Background="{StaticResource CardHi}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,8">
            <Grid>
              <TextBlock x:Name="PathText" Style="{StaticResource Hint}" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"
                         TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,70,0"/>
              <Button x:Name="BrowseButton" Style="{StaticResource Link}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Browse"/>
            </Grid>
          </Border>
          <CheckBox x:Name="OptStartup" Style="{StaticResource Switch}" Margin="0,20,0,0" IsChecked="True" Content="Start Wakelight with Windows"/>
          <CheckBox x:Name="OptLockScreen" Style="{StaticResource Switch}" Margin="0,14,0,0" IsChecked="True" Content="Allow Wakelight to set the lock screen image"/>
          <CheckBox x:Name="OptDesktop" Style="{StaticResource Switch}" Margin="0,14,0,0" IsChecked="True" Content="Desktop shortcut"/>
          <CheckBox x:Name="OptStartMenu" Style="{StaticResource Switch}" Margin="0,14,0,0" IsChecked="True" Content="Start menu shortcut"/>
        </StackPanel>
        <Grid VerticalAlignment="Bottom">
          <Button x:Name="BackButton" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Content="Back"/>
          <Button x:Name="InstallButton2" Style="{StaticResource Primary}" HorizontalAlignment="Right" Padding="30,11" Content="Install"/>
        </Grid>
      </Grid>

      <!-- Progress -->
      <Grid x:Name="PageProgress" Margin="40,56,40,32" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="ProgressEyebrow" Style="{StaticResource Eyebrow}" Text="INSTALLING"/>
          <TextBlock x:Name="ProgressTitle" Style="{StaticResource H1}" Margin="0,10,0,0" Text="Lighting things up…"/>
          <Grid Margin="0,30,0,0" Height="8">
            <Border CornerRadius="4" Background="#2A2645"/>
            <Border x:Name="ProgressFill" CornerRadius="4" Background="{StaticResource GlowH}" HorizontalAlignment="Left" Width="0">
              <Border.Effect><DropShadowEffect Color="#FF8A6A" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
            </Border>
          </Grid>
          <TextBlock x:Name="ProgressStep" Style="{StaticResource Hint}" Margin="0,12,0,0" Text="Preparing"/>
        </StackPanel>
      </Grid>

      <!-- Done -->
      <Grid x:Name="PageDone" Margin="40,56,40,32" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="DoneEyebrow" Style="{StaticResource Eyebrow}" Text="ALL SET"/>
          <TextBlock x:Name="DoneTitle" Style="{StaticResource H1}" FontSize="30" Margin="0,10,0,0" Text="Wakelight is ready."/>
          <TextBlock x:Name="DoneBody" Style="{StaticResource Body}" Foreground="{StaticResource Sub}" Margin="0,14,0,0" LineHeight="21"
                     Text="It lives in your tray, next to the clock. Step away for a few minutes and your wallpaper takes the stage."/>
          <CheckBox x:Name="LaunchCheck" Style="{StaticResource Switch}" Margin="0,26,0,0" IsChecked="True" Content="Open Wakelight now"/>
        </StackPanel>
        <Button x:Name="FinishButton" Style="{StaticResource Primary}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Padding="30,11" Content="Finish"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
